# ==============================================================================
# RESTÔLOG - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================

# Ambiente ativo: 'local' ou 'production'
VITE_APP_ENV=local

# ------------------------------------------------------------------------------
# 1. AMBIENTE LOCAL (PostgreSQL via Docker ou Qualquer Outro Banco)
# ------------------------------------------------------------------------------
# Se estiver usando o container Docker fornecido pelo projeto (npm run docker:up):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restolog

# Se estiver usando outro banco de dados PostgreSQL próprio, informe a URL acima
# ou preencha as variáveis individuais abaixo:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=restolog

# Modo Mock de demonstração (deixe 'true' para rodar offline sem nenhum banco ativo)
# Altere para 'false' ao conectar ao PostgreSQL ou Supabase
VITE_USE_MOCK=true

# ------------------------------------------------------------------------------
# 2. AMBIENTE DE PRODUÇÃO (Supabase)
# ------------------------------------------------------------------------------
# Chaves obtidas em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
