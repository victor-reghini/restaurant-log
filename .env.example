# RestôLog Environment Configuration

# Provider selection: Set to 'true' to run fully offline with in-memory mock data
# Set to 'false' to connect to your Supabase instance
VITE_USE_MOCK=true

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

