# ==========================================
# AMBIENTE DE DESENVOLVIMENTO (DEVELOPMENT)
# ==========================================
VITE_APP_ENV=development

# Modo Mock ativo para desenvolvimento ágil sem dependências externas obrigatórias
# Para conectar a uma instância de desenvolvimento do Supabase, altere para false
VITE_USE_MOCK=true

# Credenciais de Desenvolvimento (Supabase Dev ou Local Docker)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=dev-anon-key

